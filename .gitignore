# build output and installed packages -- regenerated by `npm install` / `npm run build`
node_modules/
dist/
.DS_Store
*.tsbuildinfo

# Local game-map binaries and visual references are large development inputs.
# Optimized, original scenic assets belong in public/scenic instead.
maps/
.telemetry.log

# Private source backups and local release packages are never public source.
.private/
.release/
# Credentials and machine-specific environment overrides stay local.
.env
.env.*
!.env.example
# Browser-test artifacts contain generated output, not source.
artifacts/
